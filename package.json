{
  "name": "@thimoteus/alst_core",
  "version": "1.0.1",
  "description": "Apparent Local Sidereal Time (ALST) calculation, written in ReScript. Consumable from both TypeScript and ReScript.",
  "license": "MIT",
  "author": "Evante Garza-Licudine",
  "keywords": [
    "rescript",
    "astronomy",
    "sidereal",
    "sidereal-time",
    "alst",
    "julian-date",
    "angles"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/ALST.gen.js",
  "types": "./types/ALST.gen.d.ts",
  "exports": {
    ".": {
      "types": "./types/ALST.gen.d.ts",
      "import": "./src/ALST.gen.js"
    },
    "./Angles": {
      "types": "./types/Angles.gen.d.ts",
      "import": "./src/Angles.gen.js"
    },
    "./Julian": {
      "import": "./src/Julian.res.js"
    }
  },
  "files": [
    "src/**/*.res",
    "src/**/*.res.js",
    "src/**/*.gen.js",
    "types/**/*.gen.d.ts",
    "rescript.json"
  ],
  "dependencies": {
    "rescript": "^12.2.0"
  },
  "scripts": {
    "build": "rescript && tsc",
    "clean": "rescript clean",
    "dev": "rescript watch",
    "prepare": "rescript && tsc",
    "test": "rescript && node --test src/*Test.res.js"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
